# ---------------------------------------------------------------------------
# Contact form email delivery
# ---------------------------------------------------------------------------
# All three variables are required for /api/contact to deliver an enquiry.
# Until they are set, the endpoint returns HTTP 503 and the form tells the
# visitor to email or call instead. It never reports a false success.
#
# Delivery goes through Resend (https://resend.com) over its HTTPS API, so no
# extra dependency is needed. Set these in the Vercel project settings
# (Environment Variables) — never commit real values.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=info@hecapitalmarkets.com

# Sender address. The domain must be verified in Resend, otherwise the
# provider rejects the message and the form reports a delivery error.
CONTACT_FROM_EMAIL=website@hecapitalmarkets.com
